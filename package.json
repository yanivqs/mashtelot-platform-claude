{
  "name": "nursery-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.js",
    "vercel-build": "node scripts/build.js",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:db": "vitest run -c vitest.db.config.ts",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:seed:plants": "npx prisma db seed",
    "db:seed:demo": "node seed.js",
    "db:seed:supplies": "node seed-supplies.js",
    "db:seed:print": "node seed-print.js",
    "db:seed:admin": "node seed-admin.js",
    "db:seed:all": "npm run db:seed:plants && npm run db:seed:supplies && npm run db:seed:print && npm run db:seed:demo && npm run db:seed:admin",
    "test:e2e": "node scripts/e2e.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.41.0",
    "next": "^16.4.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.26",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "npx ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
