  /// PT-07: Snapshot — גרסת התבנית, שם המוצר, הערכים שנבדקו בשרת ופירוט המחיר בעת ההזמנה
  templateVersionId String?               @map("template_version_id")
  title             String?
  values            Json?
  priceBreakdown    Json?                 @map("price_breakdown")
  printOrder        PrintOrder            @relation(fields: [printOrderId], references: [id], onDelete: Cascade)
  printProduct      PrintProduct?         @relation(fields: [printProductId], references: [id], onDelete: Restrict)
  templateVersion   PrintTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  /// PT-04: הזמנה ממוצר קבוע — גרסת המפרט המאושרת שממנה הוזמן
  savedRevisionId   String?               @map("saved_revision_id")
  savedRevision     PrintSavedRevision?   @relation(fields: [savedRevisionId], references: [id], onDelete: NoAction)

  @@map("print_order_items")
}

