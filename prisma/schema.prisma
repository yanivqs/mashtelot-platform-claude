}

/// §7.01 / §8.01: וריאנט מוצר — מחיר, SKU, ברקוד, מלאי ותמונות לפי וריאנט.
/// לכל מוצר יש בדיוק וריאנט ברירת מחדל אחד (trigger + אינדקס חלקי במיגרציה 20261019050000).
/// מלאי המוצר (nursery_products.stock_quantity/reserved_quantity) = סכום הווריאנטים הפעילים — מתוחזק ע"י trigger.
model ProductVariant {
  id               String          @id @default(uuid())
  nurseryId        String          @map("nursery_id")
  nurseryProductId String          @map("nursery_product_id")
  /// ריק בווריאנט ברירת מחדל של מוצר פשוט
  name             String          @default("")
  sku              String?
  /// טקסט — שומר אפסים מובילים (§7.02)
  barcode          String?
  /// ריק = יורש ממחיר המוצר (החלטת בעלים)
  price            Decimal?        @db.Decimal(10, 2)
  compareAtPrice   Decimal?        @map("compare_at_price") @db.Decimal(10, 2)
  stockQuantity    Int             @default(0) @map("stock_quantity")
  reservedQuantity Int             @default(0) @map("reserved_quantity")
  imageUrls        String[]        @default([]) @map("image_urls")
  isDefault        Boolean         @default(false) @map("is_default")
  isActive         Boolean         @default(true) @map("is_active")
  sortOrder        Int             @default(0) @map("sort_order")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  nursery          Nursery         @relation(fields: [nurseryId], references: [id], onDelete: Cascade)
  product          NurseryProduct  @relation(fields: [nurseryProductId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  stockMovements   StockMovement[]

  @@unique([nurseryId, sku])
  @@unique([nurseryId, barcode])
  @@index([nurseryProductId])
  @@map("product_variants")
}

/// §6.03 / R02-02: צילום של פריט מרכזי (צמח או ציוד) — נוצר ע"י trigger בכל שינוי תוכן.
model CatalogRevision {
  id         String           @id @default(uuid())
  plantId    String?          @map("plant_id")
  supplyId   String?          @map("supply_id")
  version    Int
  /// שדות התוכן בלבד (camelCase, כשמות השדות ב-Prisma)
  data       Json
  /// backfill | admin | csv | system
  source     String
  actorEmail String?          @map("actor_email")
  createdAt  DateTime         @default(now()) @map("created_at")
  plant      Plant?           @relation(fields: [plantId], references: [id], onDelete: Cascade)
  supply     MasterSupply?    @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  products   NurseryProduct[]

  @@unique([plantId, version])
  @@unique([supplyId, version])
  @@map("catalog_revisions")
}

/// §6.05: תיעוד אישור/דחייה של הצעת סנכרון.
model CatalogSyncDecision {
  id               String         @id @default(uuid())
  nurseryId        String         @map("nursery_id")
  nurseryProductId String         @map("nursery_product_id")
  fromRevisionId   String?        @map("from_revision_id")
  toRevisionId     String         @map("to_revision_id")
  accepted         String[]
  rejected         String[]
  actorEmail       String?        @map("actor_email")
  createdAt        DateTime       @default(now()) @map("created_at")
  nursery          Nursery        @relation(fields: [nurseryId], references: [id], onDelete: Cascade)
  product          NurseryProduct @relation(fields: [nurseryProductId], references: [id], onDelete: Cascade)

  @@index([nurseryId, createdAt])
  @@map("catalog_sync_decisions")
}

/// PT-02: מוצר דפוס מרכזי (נספח א — PrintCatalogProduct). ההגדרה עצמה בגרסאות.
model PrintTemplate {
  id              String                 @id @default(uuid())
  title           String
  description     String?
  category        String?
  /// תמונת דוגמה של המוצר (החלטת בעלים: ללא הדמיית ערכים)
  imageUrl        String?                @map("image_url")
  /// PT-06: האם נדרשת גרפיקה מאושרת לשחרור לייצור
  requiresArtwork Boolean                @default(true) @map("requires_artwork")
  unitLabel       String?                @map("unit_label")
  leadTimeDays    Int?                   @map("lead_time_days")
  isActive        Boolean                @default(false) @map("is_active")
  sortOrder       Int                    @default(0) @map("sort_order")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  versions        PrintTemplateVersion[]
  savedProducts   PrintSavedProduct[]

  @@map("print_templates")
}

enum PrintTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// PT-02/03/07: גרסת תבנית — סכמת שדות ותמחור. גרסה שפורסמה אינה משתנה (trigger).
model PrintTemplateVersion {
  id             String               @id @default(uuid())
  templateId     String               @map("template_id")
  version        Int
  status         PrintTemplateStatus  @default(DRAFT)
  fields         Json
  pricing        Json
  /// PT-09: פרופיל ייצור (מידות, גלישה, DPI מינימלי) לבדיקת קבצים — נעול עם הגרסה
  production     Json?
  notes          String?
  createdBy      String?              @map("created_by")
  publishedAt    DateTime?            @map("published_at")
  publishedBy    String?              @map("published_by")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  template       PrintTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  orderItems     PrintOrderItem[]
  savedRevisions PrintSavedRevision[]

  @@unique([templateId, version])
  @@map("print_template_versions")
}

/// PT-04: מוצר דפוס קבוע של משתלה (נספח א — TenantSavedPrintProduct). המפרט עצמו בגרסאות נעולות.
model PrintSavedProduct {
  id               String               @id @default(uuid())
  nurseryId        String               @map("nursery_id")
  templateId       String               @map("template_id")
  /// שם פנימי של המשתלה ("מדבקה לעציץ 1 ליטר — לוגו")
  name             String
  isArchived       Boolean              @default(false) @map("is_archived")
  /// גרסת המפרט המאושרת שממנה מזמינים
  activeRevisionId String?              @unique @map("active_revision_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  nursery          Nursery              @relation(fields: [nurseryId], references: [id], onDelete: Cascade)
  template         PrintTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  activeRevision   PrintSavedRevision?  @relation("ActiveRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  artworks         PrintArtwork[]
  revisions        PrintSavedRevision[] @relation("Revisions")

  @@index([nurseryId])
  @@map("print_saved_products")
}

enum PrintSpecStatus {
  SUBMITTED
  APPROVED
  REJECTED
  SUPERSEDED
}

/// PT-04: צילום בלתי משתנה של מפרט (גרסת תבנית + ערכים). מאושר פעם אחת בידי בית הדפוס; שינוי = גרסה חדשה.
model PrintSavedRevision {
  id                String               @id @default(uuid())
  savedProductId    String               @map("saved_product_id")
  nurseryId         String               @map("nursery_id")
  revision          Int
  templateVersionId String               @map("template_version_id")
  /// { raw, display } — כמו ב-Snapshot של הזמנה
  values            Json
  status            PrintSpecStatus      @default(SUBMITTED)
  submittedBy       String?              @map("submitted_by")
  submittedAt       DateTime             @default(now()) @map("submitted_at")
  reviewedBy        String?              @map("reviewed_by")
  reviewedAt        DateTime?            @map("reviewed_at")
  reviewNote        String?              @map("review_note")
  savedProduct      PrintSavedProduct    @relation("Revisions", fields: [savedProductId], references: [id], onDelete: Cascade)
  activeFor         PrintSavedProduct?   @relation("ActiveRevision")
  templateVersion   PrintTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  orderItems        PrintOrderItem[]

  @@unique([savedProductId, revision])
  @@map("print_saved_revisions")
}

enum PrintFileKind {
  ARTWORK
  PROOF
  PRODUCTION
}

/// PT-08: קובץ דפוס באחסון פרטי (bucket print-private / דיסק מקומי בפיתוח). נגיש רק דרך קישור זמני מהשרת.
model PrintFile {
  id           String                @id @default(uuid())
  nurseryId    String                @map("nursery_id")
  kind         PrintFileKind
  /// מפתח באחסון: {nurseryId}/{kind}/{uuid} — ללא שם הקובץ המקורי (מניעת Path Traversal)
  storageKey   String                @unique @map("storage_key")
  originalName String                @map("original_name")
  /// הסוג לפי תוכן הקובץ (magic bytes), לא לפי הדפדפן
  mimeType     String                @map("mime_type")
  sizeBytes    Int                   @map("size_bytes")
  sha256       String
  widthPx      Int?                  @map("width_px")
  heightPx     Int?                  @map("height_px")
  /// PT-09: תוצאת בדיקת קובץ בסיסית בעת הרישום — אינה משתנה
  preflight    Json?
  uploadedBy   String?               @map("uploaded_by")
  createdAt    DateTime              @default(now()) @map("created_at")
  nursery      Nursery               @relation(fields: [nurseryId], references: [id], onDelete: Cascade)
  artworkOf    PrintArtworkVersion[] @relation("ArtworkFile")
  proofOf      PrintArtworkVersion[] @relation("ProofFile")
  productionOf PrintOrder[]          @relation("ProductionFile")

  @@index([nurseryId])
  @@map("print_files")
}

/// PT-05: גרפיקה של מוצר קבוע או של הזמנה חד-פעמית — בגרסאות.
model PrintArtwork {
  id             String                @id @default(uuid())
  nurseryId      String                @map("nursery_id")
  savedProductId String?               @unique @map("saved_product_id")
  printOrderId   String?               @unique @map("print_order_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  nursery        Nursery               @relation(fields: [nurseryId], references: [id], onDelete: Cascade)
  savedProduct   PrintSavedProduct?    @relation(fields: [savedProductId], references: [id], onDelete: Cascade)
  printOrder     PrintOrder?           @relation(fields: [printOrderId], references: [id], onDelete: Cascade)
  versions       PrintArtworkVersion[]

  @@map("print_artworks")
}

enum PrintArtworkStatus {
  UPLOADED
  PROOF_SENT
  APPROVED
  REJECTED
  SUPERSEDED
}

enum PrintApprovalMethod {
  /// בעל המשתלה אישר במערכת
  OWNER
  /// בית הדפוס סימן אישור אחרי אישור טלפוני של המשתלה (החלטת בעלים)
  PHONE
}

/// PT-05: גרסת גרפיקה — קובץ נעול; הגהה ואישור מפורש מתייחסים לגרסה הזו בלבד.
model PrintArtworkVersion {
  id             String               @id @default(uuid())
  artworkId      String               @map("artwork_id")
  nurseryId      String               @map("nursery_id")
  version        Int
  fileId         String               @map("file_id")
  status         PrintArtworkStatus   @default(UPLOADED)
  proofFileId    String?              @map("proof_file_id")
  proofSentAt    DateTime?            @map("proof_sent_at")
  proofSentBy    String?              @map("proof_sent_by")
  approvedAt     DateTime?            @map("approved_at")
  approvedBy     String?              @map("approved_by")
  approvalMethod PrintApprovalMethod? @map("approval_method")
  decisionNote   String?              @map("decision_note")
  createdAt      DateTime             @default(now()) @map("created_at")
  createdBy      String?              @map("created_by")
  artwork        PrintArtwork         @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  file           PrintFile            @relation("ArtworkFile", fields: [fileId], references: [id], onDelete: NoAction)
  proofFile      PrintFile?           @relation("ProofFile", fields: [proofFileId], references: [id], onDelete: NoAction)

  @@unique([artworkId, version])
  @@map("print_artwork_versions")
}

enum PrintProductionStatus {
  PENDING
  RELEASED
  IN_PRODUCTION
  QC
  COMPLETED
  BLOCKED
}
