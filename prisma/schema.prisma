generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  fullName       String?            @map("full_name")
  phoneNumber    String?            @map("phone_number")
  passwordHash   String?            @map("password_hash")
  /// SEC-02: מוגבר בהחלפת סיסמה / "נתק את כל המכשירים" — מבטל sessions ישנים
  sessionVersion Int                @default(0) @map("session_version")
  /// §4.04: מפתח TOTP מוצפן (AES-256-GCM). קיים בלי mfaEnabledAt = הפעלה שטרם אושרה
  mfaSecretEnc   String?            @map("mfa_secret_enc")
  mfaEnabledAt   DateTime?          @map("mfa_enabled_at")
  /// הצעד האחרון שנוצל — קוד מאותו צעד או מוקדם יותר נדחה (מניעת שימוש חוזר)
  mfaLastStep    Int?               @map("mfa_last_step")
  /// R06: משתמש צוות שהושבת בידי בעל המשתלה (חסום, כולל sessions קיימים)
  disabledAt     DateTime?          @map("disabled_at")
  recoveryCodes  UserRecoveryCode[]
  role           Role               @default(CUSTOMER)
  nurseryId      String?            @map("nursery_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  orders         Order[]
  printOrders    PrintOrder[]
  nursery        Nursery?           @relation(fields: [nurseryId], references: [id])

  @@map("users")
}

/// §4.04: קודי שחזור חד-פעמיים ל-MFA — נשמר רק גיבוב SHA-256
model UserRecoveryCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("user_recovery_codes")
}

model Nursery {
  id              String                 @id @default(uuid())
  name            String
  subdomain       String                 @unique
  customDomain    String?                @unique @map("custom_domain")
  logoUrl         String?                @map("logo_url")
  primaryColor    String?                @default("#16a34a") @map("primary_color")
  phoneNumber     String?                @map("phone_number")
  ownerEmail      String                 @map("owner_email")
  isActive        Boolean                @default(true) @map("is_active")
  /// §2.03: מחזור חיים. isActive נשמר לתאימות ומסונכרן ב-trigger (פעילה ⇔ ACTIVE)
  status          NurseryStatus          @default(ACTIVE)
  aboutText       String?                @map("about_text")
  addressLine     String?                @map("address_line")
  city            String?
  mapLink         String?                @map("map_link")
  contactEmail    String?                @map("contact_email")
  openingHours    Json?                  @map("opening_hours")
  themeConfig     Json?                  @map("theme_config")
  pickupEnabled   Boolean                @default(true) @map("pickup_enabled")
  deliveryEnabled Boolean                @default(true) @map("delivery_enabled")
  deliveryNote    String?                @map("delivery_note")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  coupons         Coupon[]
  customerLoyalty CustomerLoyalty[]
  customers       Customer[]
  customerOtps    CustomerOtp[]
  customerGroups  CustomerGroup[]
  loyaltySettings LoyaltySettings?
  loyaltyEntries  LoyaltyEntry[]
  emailJobs       EmailJob[]
  modules         NurseryModule[]
  staticPages     StaticPage[]
  nurseryProducts NurseryProduct[]
  orders          Order[]
  paymentMethods  NurseryPaymentMethod[]
  redirects       Redirect[]
  productVariants ProductVariant[]
  syncDecisions   CatalogSyncDecision[]
  printSaved      PrintSavedProduct[]
  printFiles      PrintFile[]
  printArtworks   PrintArtwork[]
  printOrders     PrintOrder[]
  promotions      Promotion[]
  users           User[]
  auditEvents     AuditEvent[]
  channels        NurseryChannel[]
  shippingZones   ShippingZone[]
  categories      NurseryCategory[]
  blogPosts       BlogPost[]
  stockMovements  StockMovement[]

  @@map("nurseries")
}

enum ChannelProvider {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TELEGRAM
  LINKEDIN
  PINTEREST
  GOOGLE_BUSINESS
}

model NurseryChannel {
  id         String          @id @default(uuid())
  nurseryId  String          @map("nursery_id")
  provider   ChannelProvider
  value      String
  isEnabled  Boolean         @default(true) @map("is_enabled")
  isFeatured Boolean         @default(false) @map("is_featured")
  sortOrder  Int             @default(0) @map("sort_order")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  nursery    Nursery         @relation(fields: [nurseryId], references: [id], onDelete: Cascade)

  @@unique([nurseryId, provider])
  @@map("nursery_channels")
}

/// §21: הרצת משימת רקע — סטטוס, משך, תוצאה ושגיאה (כשל אינו נעלם בשקט)
model JobRun {
  id         String    @id @default(uuid())
  name       String
  status     JobStatus @default(RUNNING)
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  result     Json?
  error      String?

  @@index([name, startedAt])
  @@map("job_runs")
}

enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// §21: תור מיילים (Outbox) — ניסיון מיידי, וניסיונות חוזרים עם השהיה גדלה; כשל סופי גלוי לתיקון
model EmailJob {
  id            String      @id @default(uuid())
  nurseryId     String?     @map("nursery_id")
  kind          String
  /// מזהה עסקי (למשל הזמנה) — לאבחון
  refId         String?     @map("ref_id")
  to            String[]
  subject       String
  html          String
  replyTo       String?     @map("reply_to")
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at")
  lastError     String?     @map("last_error")
  providerId    String?     @map("provider_id")
  sentAt        DateTime?   @map("sent_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  nursery       Nursery?    @relation(fields: [nurseryId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("email_jobs")
}

model AuditEvent {
  id         String   @id @default(uuid())
  nurseryId  String?  @map("nursery_id")
  actorEmail String?  @map("actor_email")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  nursery    Nursery? @relation(fields: [nurseryId], references: [id], onDelete: SetNull)

  @@index([nurseryId, createdAt])
  @@map("audit_events")
}

model NurseryPaymentMethod {
  id           String        @id @default(uuid())
  nurseryId    String        @map("nursery_id")
  method       PaymentMethod
  isEnabled    Boolean       @default(true) @map("is_enabled")
  instructions String?
  destination  String?
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  nursery      Nursery       @relation(fields: [nurseryId], references: [id], onDelete: Cascade)

  @@unique([nurseryId, method])
  @@map("nursery_payment_methods")
}

model NurseryModule {
  id        String   @id @default(uuid())
  nurseryId String   @map("nursery_id")
  moduleKey String   @map("module_key")
  isEnabled Boolean  @default(false) @map("is_enabled")
  config    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  nursery   Nursery  @relation(fields: [nurseryId], references: [id], onDelete: Cascade)

  @@unique([nurseryId, moduleKey])
  @@map("nursery_modules")
}

model StaticPage {
  id                 String   @id @default(uuid())
  nurseryId          String   @map("nursery_id")
  slug               String
  title              String
  contentHtml        String   @default("") @map("content_html")
  isPublished        Boolean  @default(false) @map("is_published")
  showInNav          Boolean  @default(true) @map("show_in_nav")
  sortOrder          Int      @default(0) @map("sort_order")
  seoMetaTitle       String?  @map("seo_meta_title")
  seoMetaDescription String?  @map("seo_meta_description")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  nursery            Nursery  @relation(fields: [nurseryId], references: [id], onDelete: Cascade)

  @@unique([nurseryId, slug])
  @@map("static_pages")
}

model Plant {
  id              String                    @id @default(uuid())
  plantId         Int?                      @unique @map("plant_id")
  hebrewName      String                    @map("hebrew_name")
  latinName       String?                   @map("latin_name")
  nickname        String?
  family          String?
  description     String?
  notes           String?
  origin          String?
  native          String?
  plantType       String?                   @map("plant_type")
  light           String?
  water           String?
  flowering       String?
  floweringSeason String?                   @map("flowering_season")
  flowerColor     String?                   @map("flower_color")
  foliage         String?
  evergreen       String?
  height          String?
  spacing         String?
  growthRate      String?                   @map("growth_rate")
  climateZones    String?                   @map("climate_zones")
  resistance      String?
  coastal         String?
  care            String?
  uniqueness      String?
  imageUrl        String?                   @map("image_url")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  nurseryProducts NurseryProduct[]
  categories      PlantCategoryAssignment[]
  revisions       CatalogRevision[]

  @@map("plants")
}

model PlantCategory {
  id        String                    @id @default(uuid())
  name      String                    @unique
  slug      String                    @unique
  parentId  String?                   @map("parent_id")
  sortOrder Int                       @default(0) @map("sort_order")
  createdAt DateTime                  @default(now()) @map("created_at")
  parent    PlantCategory?            @relation("PlantCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  PlantCategory[]           @relation("PlantCategoryTree")
  plants    PlantCategoryAssignment[]

  @@map("plant_categories")
}

model PlantCategoryAssignment {
  plantId    String        @map("plant_id")
  categoryId String        @map("category_id")
  plant      Plant         @relation(fields: [plantId], references: [id], onDelete: Cascade)
  category   PlantCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([plantId, categoryId])
  @@map("plant_category_assignments")
}

model MasterSupply {
  id              String            @id @default(uuid())
  title           String
  brand           String?
  category        SupplyCategory    @default(GENERAL)
  barcode         String?           @unique
  description     String?
  imageUrl        String?           @map("image_url")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  nurseryProducts NurseryProduct[]
  revisions       CatalogRevision[]

  @@map("master_supplies")
}

model NurseryProduct {
  id                 String                   @id @default(uuid())
  nurseryId          String                   @map("nursery_id")
  plantId            String?                  @map("plant_id")
  supplyId           String?                  @map("supply_id")
  customTitle        String?                  @map("custom_title")
  customImageUrl     String?                  @map("custom_image_url")
  price              Decimal                  @db.Decimal(10, 2)
  compareAtPrice     Decimal?                 @map("compare_at_price") @db.Decimal(10, 2)
  /// on_hand — יחידות פיזיות במלאי
  stockQuantity      Int                      @default(0) @map("stock_quantity")
  /// יחידות שמורות להזמנות פתוחות; זמין = stockQuantity - reservedQuantity
  reservedQuantity   Int                      @default(0) @map("reserved_quantity")
  isActive           Boolean                  @default(true) @map("is_active")
  customDescription  String?                  @map("custom_description")
  seoMetaTitle       String?                  @map("seo_meta_title")
  seoMetaDescription String?                  @map("seo_meta_description")
  /// שם האפשרות בבחירת וריאנט (למשל "גודל עציץ"); ריק = "אפשרות"
  optionLabel        String?                  @map("option_label")
  /// §6: גרסת הפריט המרכזי שאושרה למוצר — החנות מציגה אותה (לא את הקטלוג החי)
  catalogRevisionId  String?                  @map("catalog_revision_id")
  /// §6.02: שדות שנשמרו מקומית ואינם מוצעים לסנכרון — { שדה: ערך }
  catalogOverrides   Json?                    @map("catalog_overrides")
  catalogRevision    CatalogRevision?         @relation(fields: [catalogRevisionId], references: [id], onDelete: SetNull)
  syncDecisions      CatalogSyncDecision[]
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  variants           ProductVariant[]
  favoritedBy        CustomerFavorite[]
  nursery            Nursery                  @relation(fields: [nurseryId], references: [id], onDelete: Cascade)
  plant              Plant?                   @relation(fields: [plantId], references: [id])
  supply             MasterSupply?            @relation(fields: [supplyId], references: [id])
  orderItems         OrderItem[]
  categories         NurseryProductCategory[]
  stockMovements     StockMovement[]

  @@unique([nurseryId, plantId])
  @@unique([nurseryId, supplyId])
  @@map("nursery_products")
}

model ShippingZone {
  id                    String                 @id @default(uuid())
  nurseryId             String                 @map("nursery_id")
  name                  String
  isEnabled             Boolean                @default(true) @map("is_enabled")
  shippingPrice         Decimal                @map("shipping_price") @db.Decimal(10, 2)
  freeShippingThreshold Decimal?               @map("free_shipping_threshold") @db.Decimal(10, 2)
  sortOrder             Int                    @default(0) @map("sort_order")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  nursery               Nursery                @relation(fields: [nurseryId], references: [id], onDelete: Cascade)
  cities                ShippingZoneCity[]
  postcodes             ShippingZonePostcode[]
  orders                Order[]

  @@map("shipping_zones")
}

model ShippingZoneCity {
  id                 String       @id @default(uuid())
  shippingZoneId     String       @map("shipping_zone_id")
  cityName           String       @map("city_name")
  normalizedCityName String       @map("normalized_city_name")
  zone               ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)

  @@unique([shippingZoneId, normalizedCityName])
  @@map("shipping_zone_cities")
}

/// §11.01: מיקוד מלא או התחלה (1–7 ספרות). מיקוד הלקוח שתואם גובר על העיר; ההתחלה הארוכה ביותר מנצחת.
model ShippingZonePostcode {
  id             String       @id @default(uuid())
  shippingZoneId String       @map("shipping_zone_id")
  prefix         String
  zone           ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)

  @@unique([shippingZoneId, prefix])
  @@map("shipping_zone_postcodes")
}

model Order {
  id                   String          @id @default(uuid())
  nurseryId            String          @map("nursery_id")
  userId               String?         @map("user_id")
  /// R06-03: חשבון הלקוח בחנות (הזמנה כאורח — ריק; משויך אחרי אימות המייל)
  customerId           String?         @map("customer_id")
  customerName         String          @map("customer_name")
  customerEmail        String          @map("customer_email")
  customerPhone        String          @map("customer_phone")
  shippingAddress      String?         @map("shipping_address")
  shippingPostcode     String?         @map("shipping_postcode")
  deliveryMethod       DeliveryMethod? @map("delivery_method")
  totalAmount          Decimal         @map("total_amount") @db.Decimal(10, 2)
  status               OrderStatus     @default(RECEIVED)
  paymentStatus        PaymentStatus   @default(UNPAID) @map("payment_status")
  stockState           StockState      @default(NONE) @map("stock_state")
  /// עד מתי המלאי שמור להזמנה שטרם אושרה (null = ללא פקיעה)
  reservationExpiresAt DateTime?       @map("reservation_expires_at")
  idempotencyKey       String?         @map("idempotency_key")
  subtotalAmount       Decimal?        @map("subtotal_amount") @db.Decimal(10, 2)
  discountAmount       Decimal?        @map("discount_amount") @db.Decimal(10, 2)
  /// R06-07: Snapshot של הנחת קבוצת הלקוח (לפני הקופון)
  groupDiscountPct     Decimal?        @map("group_discount_pct") @db.Decimal(5, 2)
  groupDiscountAmount  Decimal?        @map("group_discount_amount") @db.Decimal(10, 2)
  /// R06-06: נקודות שמומשו בהזמנה וערכן בש"ח
  loyaltyPointsUsed    Int?            @map("loyalty_points_used")
  loyaltyDiscount      Decimal?        @map("loyalty_discount") @db.Decimal(10, 2)
  loyaltyEntries       LoyaltyEntry[]
  discountPct          Decimal?        @map("discount_pct") @db.Decimal(5, 2)
  couponCode           String?         @map("coupon_code")
  couponId             String?         @map("coupon_id")
  paymentMethod        PaymentMethod?  @map("payment_method")
  paymentReference     String?         @map("payment_reference")
  shippingZoneId       String?         @map("shipping_zone_id")
  shippingCost         Decimal?        @map("shipping_cost") @db.Decimal(10, 2)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  items                OrderItem[]
  nursery              Nursery         @relation(fields: [nurseryId], references: [id], onDelete: Cascade)
  user                 User?           @relation(fields: [userId], references: [id])
  customer             Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingZone         ShippingZone?   @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  coupon               Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  stockMovements       StockMovement[]

  @@unique([nurseryId, idempotencyKey])
  @@index([stockState, reservationExpiresAt])
  @@index([customerId])
  @@map("orders")
}

/// R06-03/04: חשבון לקוח בחנות של משתלה אחת (אותו אדם בשתי משתלות — שני חשבונות). התחברות בקוד חד-פעמי במייל.
model Customer {
  id                 String             @id @default(uuid())
  nurseryId          String             @map("nursery_id")
  /// מנורמל (אותיות קטנות)
  email              String
  fullName           String?            @map("full_name")
  phone              String?
  /// R06-07: פרטי / עסקי
  type               CustomerType       @default(PRIVATE)
  companyName        String?            @map("company_name")
  taxId              String?            @map("tax_id")
  /// R06-05: תגיות חופשיות (CRM)
  tags               String[]           @default([])
  groupId            String?            @map("group_id")
  group              CustomerGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  notes              CustomerNote[]
  /// R06-09: הסכמה לדיוור — רק לקוחות שהסכימו ייוצאו לשיווק
  marketingConsentAt DateTime?          @map("marketing_consent_at")
  /// מוגבר ביציאה מכל המכשירים — מבטל sessions ישנים
  sessionVersion     Int                @default(0) @map("session_version")
  lastLoginAt        DateTime?          @map("last_login_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  nursery            Nursery            @relation(fields: [nurseryId], references: [id], onDelete: Cascade)
  orders             Order[]
  addresses          CustomerAddress[]
  loyaltyEntries     LoyaltyEntry[]
  favorites          CustomerFavorite[]

  @@unique([nurseryId, email])
  @@map("customers")
}

/// R06-06: הגדרות מועדון הנקודות של משתלה. pointValue = 0 → צבירה ומימוש כבויים.
model LoyaltySettings {
  nurseryId       String   @id @map("nursery_id")
  /// נקודות לכל ₪1 ששולם על מוצרים (אחרי הנחות, בלי משלוח)
  pointsPerShekel Decimal  @default(1) @map("points_per_shekel") @db.Decimal(6, 2)
  /// שווי נקודה בש"ח — בעל המשתלה מגדיר
  pointValue      Decimal  @default(0) @map("point_value") @db.Decimal(8, 4)
  /// מימוש עד X% מסכום המוצרים אחרי הנחות
  maxRedeemPct    Int      @default(50) @map("max_redeem_pct")
  updatedAt       DateTime @updatedAt @map("updated_at")
  nursery         Nursery  @relation(fields: [nurseryId], references: [id], onDelete: Cascade)

  @@map("loyalty_settings")
}

enum LoyaltyKind {
  EARN
  REDEEM
  REVERSE_EARN
  REFUND_REDEEM
  ADJUST
}

/// R06-06: יומן הנקודות (Ledger) — שורות לא משתנות; היתרה = סכום הנקודות. פעולה אחת מכל סוג להזמנה.
model LoyaltyEntry {
  id         String      @id @default(uuid())
  nurseryId  String      @map("nursery_id")
  customerId String      @map("customer_id")
  orderId    String?     @map("order_id")
  kind       LoyaltyKind
  points     Int
  note       String?
  actorEmail String?     @map("actor_email")
  createdAt  DateTime    @default(now()) @map("created_at")
  nursery    Nursery     @relation(fields: [nurseryId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([orderId, kind])
  @@index([customerId])
  @@map("loyalty_entries")
}

enum CustomerType {
  PRIVATE
  BUSINESS
}

/// R06-05/07: קבוצת לקוחות של משתלה (בשלב 4 — גם הנחת קבוצה)
model CustomerGroup {
  id          String     @id @default(uuid())
  nurseryId   String     @map("nursery_id")
  name        String
  /// R06-07: הנחה באחוזים לכל הקטלוג ללקוחות הקבוצה (0–50)
  discountPct Decimal    @default(0) @map("discount_pct") @db.Decimal(5, 2)
  createdAt   DateTime   @default(now()) @map("created_at")
  nursery     Nursery    @relation(fields: [nurseryId], references: [id], onDelete: Cascade)
  customers   Customer[]

