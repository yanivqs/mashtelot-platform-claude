/// מצב המלאי של הזמנה: NONE (הצעת מחיר) · RESERVED · RELEASED (פג/בוטל) · COMMITTED (ירד מהמלאי)
enum StockState {
  NONE
  RESERVED
  RELEASED
  COMMITTED
}

enum StockMovementReason {
  RESERVE
  RELEASE_EXPIRED
  RELEASE_CANCELLED
  COMMIT
  RESTORE_CANCELLED
  MANUAL_ADJUST
}

/// תנועת מלאי — רשומה בלתי ניתנת לשינוי (אפיון §8.02). אין קוד שמעדכן או מוחק שורות.
model StockMovement {
  id               String              @id @default(uuid())
  nurseryId        String              @map("nursery_id")
  nurseryProductId String              @map("nursery_product_id")
  variantId        String?             @map("variant_id")
  orderId          String?             @map("order_id")
  reason           StockMovementReason
  /// שינוי ב-on_hand (stockQuantity)
  onHandDelta      Int                 @default(0) @map("on_hand_delta")
  /// שינוי ב-reservedQuantity
  reservedDelta    Int                 @default(0) @map("reserved_delta")
  actorEmail       String?             @map("actor_email")
  createdAt        DateTime            @default(now()) @map("created_at")
  nursery          Nursery             @relation(fields: [nurseryId], references: [id], onDelete: Cascade)
  nurseryProduct   NurseryProduct      @relation(fields: [nurseryProductId], references: [id], onDelete: Cascade)
  variant          ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  order            Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([nurseryId, createdAt])
  @@index([nurseryProductId, createdAt])
