# PostgreSQL (Supabase) - transaction pooler for the app, session pooler for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Root domain for building tenant storefront URLs (no protocol).
# Dev: "localhost:3000"  |  Prod: "mashtelot.net"
ROOT_DOMAIN="localhost:3000"

# Secret for signing admin session JWTs.  Generate: openssl rand -hex 32
AUTH_SECRET="change-me"

# Transactional email (Resend). Domain must be verified in Resend.
# If unset, checkout still works but no emails are sent.
RESEND_API_KEY=""
EMAIL_FROM="משתלות מ.נט <orders@mashtelot.net>"
# אופציונלי: עותק של כל הזמנה (מכל המשתלות) למנהל הפלטפורמה, מופרד בפסיקים
ORDER_NOTIFY_EMAILS=""

# Image uploads (Supabase Storage). Needs a public bucket named "uploads".
# SUPABASE_URL is the project API URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------- בדיקות (קובץ נפרד: .env.test, מוחרג מ-git) ----------
# בדיקות בסיס נתונים (npm run test:db) רצות רק מול יעד בדיקות מאומת:
# Postgres מקומי שבסיס הנתונים שלו מסתיים ב-_test, או פרויקט Supabase שה-ref שלו
# מופיע ב-TEST_DB_ALLOWED_REFS. לעולם לא מול DATABASE_URL / DIRECT_URL שלמעלה.
# הריצה מאפסת את הסכמה ביעד (prisma migrate reset)!
TEST_DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/mashtelot_test"
TEST_DB_ALLOWED_REFS=""
