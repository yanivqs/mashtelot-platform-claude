# PostgreSQL (Supabase) - transaction pooler for the app, session pooler for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Root domain for building tenant storefront URLs (no protocol).
# Dev: "localhost:3000"  |  Prod: "mashtelot.com"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
